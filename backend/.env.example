# ==============================================================================
# NASS LASUSTECH BACKEND SERVICE CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:8080
BACKEND_URL=http://localhost:5001

# Admin Portal Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password
ADMIN_EMAIL=admin@science.lasustech.edu.ng

# Korapay Mode (test / live)
KORAPAY_MODE=test

# Korapay Live Credentials
KORAPAY_PUBLIC_KEY=pk_live_your_live_public_key_here
KORAPAY_SECRET_KEY=sk_live_your_live_secret_key_here
KORAPAY_BASE_URL=https://api.korapay.com/merchant/api/v1

# Korapay Test Credentials (for sandbox testing)
KORAPAY_TEST_PUBLIC_KEY=pk_test_your_test_public_key_here
KORAPAY_TEST_SECRET_KEY=sk_test_your_test_secret_key_here

# Central ID System Key
ID_SYSTEM_API_KEY=YOUR_SECURE_API_KEY

# SMTP / Mailer Gateway Configuration (Gmail App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=nasslasustech@gmail.com
SMTP_PASS=your_16_character_google_app_password
SMTP_FROM_NAME="Nigerian Association of Science Students (NASS LASUSTECH)"
SMTP_FROM_EMAIL=nasslasustech@gmail.com
