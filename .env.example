# ==============================================================================
# NASS LASUSTECH LOCAL ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

# Supabase (Primary Database, Auth & Realtime)
# Replace with your Supabase Project URL and Anon/Public Key
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Local Microservice API URLs (Optional if using Supabase directly)
VITE_API_URL=http://localhost:5000/api
VITE_VOTING_API_URL=http://localhost:5050/api

# Korapay Gateway (test / live)
VITE_KORAPAY_MODE=test
VITE_KORAPAY_PUBLIC_KEY=pk_live_your_live_public_key_here
VITE_KORAPAY_TEST_PUBLIC_KEY=pk_test_your_test_public_key_here
