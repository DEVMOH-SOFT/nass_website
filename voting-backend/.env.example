# ==============================================================================
# NASS LASUSTECH AWARDS VOTING BACKEND CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================

PORT=5050
NODE_ENV=development
FRONTEND_URL=http://localhost:8080
VOTING_WEBHOOK_BASE_URL=http://localhost:5050
JWT_SECRET=your_jwt_secret_key_change_me

# MySQL Database Settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=nass_awards
DB_USER=root
DB_PASSWORD=

# Voting Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_admin_password
ADMIN_DISPLAY_NAME=NASS Awards Admin

# Korapay Mode (test / live)
KORAPAY_MODE=test

# Korapay Live Credentials
KORAPAY_PUBLIC_KEY=pk_live_your_live_public_key_here
KORAPAY_SECRET_KEY=sk_live_your_live_secret_key_here
KORAPAY_BASE_URL=https://api.korapay.com/merchant/api/v1

# Korapay Test Credentials
KORAPAY_TEST_PUBLIC_KEY=pk_test_your_test_public_key_here
KORAPAY_TEST_SECRET_KEY=sk_test_your_test_secret_key_here

# Event / Awards Configuration
VOTING_EVENT_NAME=NASS Awards
VOTING_EVENT_EDITION=2026
VOTING_AWARDS_DATE=2026-06-17T18:00:00+01:00
VOTING_CLOSES_AT=2026-06-07T23:59:59+01:00
VOTE_PRICE=100
VOTE_CURRENCY=NGN
