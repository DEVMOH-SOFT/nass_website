# ==============================================================================
# NASS LASUSTECH PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE (.env.production.example)
# ==============================================================================

# Supabase (Primary Database, Auth & Realtime)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Production API URLs
VITE_API_URL=https://your-backend-api-domain.com/api
VITE_VOTING_API_URL=https://your-voting-api-domain.com/api

# Korapay Gateway (Production Live Mode)
VITE_KORAPAY_MODE=live
VITE_KORAPAY_PUBLIC_KEY=pk_live_your_live_public_key_here
